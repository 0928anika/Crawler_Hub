  "extensions": [],
  "official_color_codes": true,
  "image_color_mapping": "verified",
  "capabilities": {
    "size": {
      "supported": true,
      "status": "conditional",
      "reason": "공식 색상별 상품번호의 사이즈 select 옵션. disabled/품절 사이즈 포함, 문자열 유지."
    },
    "price": {
      "supported": true,
      "status": "conditional",
      "reason": "공식 공개 product:sale_price:amount 우선, 할인 판매가가 없는 상품은 product:price:amount. KRW 확인. 쿠폰/회원가 제외."
    },
    "regular_price": {
      "supported": true,
      "status": "conditional",
      "reason": "공식 독립 소비자가 #span_product_price_custom. 없으면 빈칸과 경고."
    },
    "category": {
      "supported": true,
      "status": "conditional",
      "reason": "공식 CAFE24.FRONT_JS_CONFIG_SHOP.oCategoryInfo의 카테고리 경로."
    },
    "main_image": {
      "supported": true,
      "status": "conditional",
      "reason": "공식 색상별 상품 갤러리. 바이트/픽셀/형식/비율 검사 후 5슬롯 구성."
    },
    "additional_images": {
      "supported": true,
      "status": "conditional",
      "reason": "공식 색상별 상품 갤러리. 바이트/픽셀/형식/비율 검사 후 5슬롯 구성."
    },
    "detail_page": {
      "supported": true,
      "status": "conditional",
      "reason": "공식 #prdDetailContent 본문 이미지. 공통 브랜드 소개 제외. 고시/사이즈표 별도 생성 없음."
    }
  },
  "guide": {
    "example": "YEW4FW201A",
    "examples": [
      "YEW4FW201A",
      "YEW4FW201A_BK"
    ],
    "pattern": "^[A-Za-z0-9]+(?:[_-][A-Za-z0-9]{2,4})?$",
    "format": "기본 품번 또는 기본품번_공식색상코드",
    "notes": "기본 품번은 검색되는 전체 색상. 공식 색상코드 지정 시 해당 색상만.",
    "method": "공식 품번 검색 후 페이지 상품번호, 상품명 색상, 본문 이미지 경로의 정확한 품번+색상코드를 대조합니다.",
    "required_columns": [
      "품번"
    ],
    "invalid_examples": [
      "YEW4FW201A_"
    ],
    "validation_note": "실제 상품과 색상 존재는 실행 시 확인."
  },
  "notes": "공식 색상별 페이지의 상품 갤러리와 본문 수집. 브랜드 소개/이벤트/배송 이미지는 제외. 고시와 사이즈표는 본문 이미지를 유지하며 별도 생성하지 않습니다. 검색 0건/접근 오류 구분. 빈 카테고리 키 제외. Colors 요약 페이지 대신 검색된 개별 색상 페이지 수집.",
