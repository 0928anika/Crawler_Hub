{
  "id": "phantom_official",
  "name": "팬텀",
  "category": "골프 의류",
  "crawl_source": "공식 홈페이지",
  "script": "phantom_official.py",
  "execution_level": 1,
  "mapping_mode": "automatic",
  "image_mode": "url",
  "output_headers": [
    "품번",
    "상품명",
    "색상",
    "상품 링크",
