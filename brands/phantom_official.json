    "원본 상품명",
    "사이트 브랜드"
  ],
  "extensions": [],
  "official_color_codes": true,
  "image_color_mapping": "verified",
  "capabilities": {
    "size": {
      "supported": true,
      "status": "conditional",
      "reason": "해당 색상 상품의 공식 optionList.option2List 사이즈 전체(품절 포함)."
    },
    "price": {
      "supported": true,
      "status": "conditional",
      "reason": "공식 검색 API price.real(없으면 priceInfo.currentPrice)."
    },
    "regular_price": {
      "supported": true,
      "status": "conditional",
      "reason": "공식 검색 API price.tag(정가 필드). 미표시·0·형식오류는 빈칸, 판매가로 대체하지 않음."
    },
    "category": {
      "supported": true,
      "status": "conditional",
      "reason": "공식 lambda API itemkind/category 경로."
    },
    "main_image": {
      "supported": true,
      "status": "conditional",
      "reason": "색상별 상품코드의 공식 goodsDetail.imageList. 공개 접근·규격 검사."
    },
    "additional_images": {
      "supported": true,
      "status": "conditional",
      "reason": "같은 imageList에서 검사 통과 컷 5슬롯."
    },
    "detail_page": {
      "supported": true,
      "status": "conditional",
      "reason": "공식 goodsDescription 이미지 + notificationInfoList 고시 표 + 사이즈 측정 이미지→실측표."
    }
  },
  "guide": {
    "pattern": "^[A-Za-z0-9]{6,20}(?:_[A-Za-z0-9]{1,4})?$",
    "format": "기본 품번(예: 211F3CB201) 또는 품번_색상코드(예: 211F3CB201_TQ)",
    "notes": "기본 품번은 모든 색상, 색상코드까지 넣으면 그 색상만.",
    "method": "공식 검색 API의 상품코드를 품번_색상코드 구조로 정확히 대조.",
    "example": "211F3CB201",
    "examples": [
      "211F3CB201"
    ],
    "required_columns": [
      "품번"
    ],
    "invalid_examples": [
      "공백"
    ],
    "validation_note": "입력 형식 검사이며 실제 상품 존재 확인은 실행 시 수행"
  },
  "notes": "버킷스토어 공식 팬텀(FANTOM) 상품만 수집. 기본 품번 입력 시 전체 색상, 품번_색상코드 입력 시 해당 색상만 자동 매핑. 공식 본문·상품고시·사이즈 안내/실측표를 조합하고 없는 자료는 생략. 예시 211F3CB201_TQ 실사이트 검증.",
  "interface": "portal_v1",
